---
import type { CollectionMeta } from '../lib/content';
import { collectionPath } from '../lib/content';

interface Props {
  collection: CollectionMeta & { count: number };
}

const { collection } = Astro.props;
---

<a class="collection-card" href={collectionPath(collection.slug)}>
  <span class="collection-cover" aria-hidden="true">{collection.title.slice(0, 1)}</span>
  <span class="collection-info">
    <span class="collection-label">合集</span>
    <span class="collection-title">{collection.title}</span>
    <span class="collection-count">共 {collection.count} 篇内容</span>
  </span>
  <span class="collection-arrow" aria-hidden="true">›</span>
</a>

<style>
  .collection-card {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px var(--content-padding) 0;
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--color-quote-bg);
    color: var(--color-text);
  }

  .collection-card:hover {
    text-decoration: none;
    background: var(--color-border);
  }

  .collection-cover {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, #dbe7ff, #c2d6ff);
    color: #3c5a99;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .collection-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .collection-label {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-caption);
    letter-spacing: 0;
  }

  .collection-title {
    margin-top: 2px;
    overflow: hidden;
    font-size: 15px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .collection-count {
    margin-top: 2px;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-caption);
    letter-spacing: 0;
  }

  .collection-arrow {
    flex: none;
    color: var(--color-text-tertiary);
    font-size: 22px;
    line-height: 1;
  }
</style>
