---
import { SITE_NAME, SITE_DESCRIPTION, SITE_AVATAR } from '../consts';

const nav = [
  { href: '/', label: '首页' },
  { href: '/archive.html', label: '日志' },
  { href: '/collections.html', label: '合集' },
  { href: '/collect.html', label: '收藏' },
  { href: '/others.html', label: '圈外' },
  { href: '/link.html', label: '友链' },
  { href: '/about.html', label: '关于' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/'
    ? path === '/'
    : path === href || (href === '/collections.html' && path.startsWith('/collection/'));
---

<header class="site-header">
  <div class="profile">
    <img class="avatar" src={SITE_AVATAR} alt={SITE_NAME} width="56" height="56" loading="eager" />
    <div class="profile-text">
      <h1 class="site-name"><a href="/">{SITE_NAME}</a></h1>
      <p class="site-description">{SITE_DESCRIPTION}</p>
    </div>
  </div>

  <nav class="site-nav" aria-label="主导航">
    {nav.map((item) => (
      <a
        class:list={['nav-item', { active: isActive(item.href) }]}
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    padding: 24px var(--content-padding) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-quote-bg);
  }

  .profile-text {
    min-width: 0;
  }

  .site-name {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.5px;
  }

  .site-name a {
    color: var(--color-text);
  }

  .site-name a:hover {
    text-decoration: none;
  }

  .site-description {
    margin: 4px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    line-height: 1.5;
    letter-spacing: 0;
  }

  .site-nav {
    display: flex;
    gap: 20px;
    margin: 16px -20px 0;
    padding: 0 var(--content-padding);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .site-nav::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    position: relative;
    padding: 0 0 12px;
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.2;
    white-space: nowrap;
  }

  .nav-item:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-item.active {
    color: var(--color-text);
    font-weight: 600;
  }

  .nav-item.active::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    content: '';
  }
</style>
