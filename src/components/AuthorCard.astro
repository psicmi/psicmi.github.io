---
import { SITE_AVATAR, SITE_DESCRIPTION, SITE_NAME } from '../consts';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={['author-card', { compact }]}>
  <img class="author-avatar" src={SITE_AVATAR} alt={SITE_NAME} width="48" height="48" loading="lazy" />
  <div class="author-info">
    <p class="author-name">{SITE_NAME}</p>
    <p class="author-desc">{SITE_DESCRIPTION}</p>
  </div>
  <a class="author-action" href="/feed/" target="_blank" rel="noopener">RSS 订阅</a>
</aside>

<style>
  .author-card {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 32px var(--content-padding) 0;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .author-card.compact {
    margin: 0;
    padding: 12px;
  }

  .author-avatar {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-quote-bg);
  }

  .author-info {
    flex: 1;
    min-width: 0;
  }

  .author-name {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .author-desc {
    margin: 2px 0 0;
    overflow: hidden;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-caption);
    line-height: 1.5;
    letter-spacing: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .author-action {
    flex: none;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: var(--font-size-caption);
    letter-spacing: 0;
  }

  .author-action:hover {
    text-decoration: none;
    opacity: 0.9;
  }
</style>
