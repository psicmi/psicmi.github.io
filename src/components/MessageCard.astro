---
import type { Post } from '../lib/content';
import { cleanSummary, dateParts, postCollections, postPath } from '../lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const parts = dateParts(post.data.date);
const collections = postCollections(post);
const excerpt = cleanSummary(post.data.summary, 90);
---

<a class="message" href={postPath(post)}>
  <div class="message-main">
    <h2 class="message-title">{post.data.title}</h2>
    {excerpt && <p class="message-summary">{excerpt}</p>}
    <div class="message-meta">
      {collections.length > 0 && <span class="message-collection">{collections[0].title}</span>}
      <time datetime={parts.date}>{parts.monthDay}</time>
    </div>
  </div>
</a>

<style>
  .message {
    display: block;
    padding: 16px var(--content-padding);
    border-bottom: 1px solid var(--color-border);
    color: inherit;
  }

  .message:last-child {
    border-bottom: 0;
  }

  .message:hover {
    background: var(--color-quote-bg);
    text-decoration: none;
  }

  .message-title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.2px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .message-summary {
    display: -webkit-box;
    margin: 8px 0 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .message-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-caption);
    letter-spacing: 0;
  }

  .message-collection {
    color: var(--color-link);
  }
</style>
